// 主界面：这个文件只负责"组装"，具体零件都在别的文件里，改一个组件不用动这里。
// 这个文件由 build.rs 编译，src/lib.rs 通过 slint::include_modules!() 引入。
//
// 目录结构：
//   ui/theme.slint                  —— Palette 配色 / Icons 图标 / Style 取色工具
//   ui/types.slint                  —— Notice、NavItem 数据结构（Rust 侧会生成同名 struct）
//   ui/components/icon.slint        —— Icon：统一尺寸的线性图标
//   ui/components/chip.slint        —— Chip：小圆角标签
//   ui/components/notice-card.slint —— NoticeCard：一条通知卡片
//   ui/components/nav-cell.slint    —— NavCell：底部导航的一格
//   ui/app-window.slint（本文件）    —— AppWindow：标题栏 + 搜索框 + 分段筛选 + 卡片列表 + 底部导航
//
// 注意：组件要跨文件用，定义方必须写 export；import 的路径是相对当前文件所在目录的。

import { Palette, Icons } from "theme.slint";
import { Notice, NavItem } from "types.slint";
import { Icon } from "components/icon.slint";
import { NoticeCard } from "components/notice-card.slint";
import { NavCell } from "components/nav-cell.slint";

// ---------------------------------------------------------------------------
// 主界面
// ---------------------------------------------------------------------------
export component AppWindow inherits Window {
    title: "通知中心";
    // 注意：这里不要写死 width/height。写死会把根元素卡在那个尺寸，
    // 真机上就不会跟着屏幕大小走；窗口尺寸交给平台（Android 就是整屏）。
    background: @linear-gradient(180deg, Palette.bg-top 0%, Palette.bg-bottom 100%);

    in-out property <[Notice]> notices: [
        {
            kind: 0,
            title: "Slint 1.18 已发布",
            body: "新的渲染后端上线，启动更快、动画更顺滑，建议升级。",
            tag: "公告",
            time: "09:24",
            unread: true,
            important: true,
        },
        {
            kind: 1,
            title: "本周五线上分享会",
            body: "主题：用一个下午写个 Android 小程序。报名截止周四 18:00。",
            tag: "活动",
            time: "昨天",
            unread: true,
            important: false,
        },
        {
            kind: 2,
            title: "新的登录设备",
            body: "Pixel 8 · 上海 · 刚刚。如果不是你本人操作，请立刻修改密码。",
            tag: "安全",
            time: "昨天",
            unread: true,
            important: false,
        },
        {
            kind: 3,
            title: "构建流水线已修复",
            body: "缓存策略调整完成，CI 构建时间从 6 分钟降到 3 分钟。",
            tag: "更新",
            time: "周二",
            unread: false,
            important: false,
        },
        {
            kind: 1,
            title: "十二月社区投票开启",
            body: "为你最想要的新特性投上一票，投票结果会在下次迭代里优先实现。",
            tag: "活动",
            time: "上周",
            unread: false,
            important: false,
        },
    ];

    property <[NavItem]> nav-items: [
        { label: "首页", icon: Icons.home, badge: 0 },
        { label: "通知", icon: Icons.bell, badge: 3 },
        { label: "收藏", icon: Icons.star, badge: 0 },
        { label: "我的", icon: Icons.user, badge: 0 },
    ];

    // 当前选中的分段（0=全部 1=未读 2=重要）与底部导航项，Rust 侧也可以设置
    in-out property <int> tab: 0;
    in-out property <int> nav: 1;
    // 顶部日期文案（真实项目里可以由 Rust 侧填今天的日期）
    in-out property <string> today: "2026 年 9 月 24 日 · 星期四";

    // 刘海屏 / 手势条留白；桌面预览时 safe-area-insets 是 0，所以给个最小值
    property <length> pad-top: max(self.safe-area-insets.top, 18px);
    property <length> pad-bottom: max(self.safe-area-insets.bottom, 8px);
    property <length> nav-bar-height: 64px + self.pad-bottom;

    // 背景光晕（纯装饰，让深色背景不那么平）
    Rectangle {
        x: -90px;
        y: -150px;
        width: 340px;
        height: 340px;
        border-radius: 170px;
        background: @radial-gradient(circle, Palette.accent.with-alpha(0.30) 0%, transparent 70%);
    }
    Rectangle {
        x: parent.width - 180px;
        y: -70px;
        width: 280px;
        height: 280px;
        border-radius: 140px;
        background: @radial-gradient(circle, Palette.accent-2.with-alpha(0.18) 0%, transparent 70%);
    }

    // 内容区（可上下滑动，底部让开导航栏）
    Flickable {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height - nav-bar.height;
        // 内容高度显式绑定：内部用了 for 循环，Flickable 不会自己算高度
        content-width: self.width;
        content-height: content-layout.preferred-height;

        content-layout := VerticalLayout {
            // 手机上就是整屏宽；平板/大屏时限制一下宽度并居中，免得被拉得很散
            width: min(parent.width, 520px);
            x: (parent.width - self.width) / 2;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: pad-top + 8px;
            padding-bottom: 24px;
            spacing: 16px;

            // ---- 标题栏 ----
            HorizontalLayout {
                spacing: 14px;
                cross-axis-alignment: center;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;

                    Text {
                        text: root.today;
                        font-size: 12px;
                        color: Palette.text-3;
                    }

                    Text {
                        text: "通知中心";
                        font-size: 26px;
                        font-weight: 700;
                        color: Palette.text-1;
                        letter-spacing: 0.5px;
                    }
                }

                Rectangle {
                    width: 46px;
                    height: 46px;
                    border-radius: 23px;
                    background: @linear-gradient(135deg, Palette.accent 0%, Palette.accent-2 100%);
                    border-width: 1px;
                    border-color: Palette.stroke-strong;

                    Icon {
                        d: Icons.user;
                        tint: #ffffff;
                        icon-size: 22px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    Rectangle { // 在线状态
                        width: 13px;
                        height: 13px;
                        border-radius: 7px;
                        background: Palette.ok;
                        border-width: 2px;
                        border-color: Palette.bg-top;
                        x: parent.width - self.width;
                        y: parent.height - self.height;
                    }
                }
            }

            // ---- 搜索框 ----
            Rectangle {
                height: 46px;
                border-radius: 15px;
                background: #ffffff0d;
                border-width: 1px;
                border-color: Palette.stroke;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 6px;
                    spacing: 10px;
                    cross-axis-alignment: center;

                    Icon {
                        d: Icons.search;
                        tint: Palette.text-3;
                        icon-size: 19px;
                    }

                    Text {
                        text: "搜索通知、发送人或关键词";
                        font-size: 13px;
                        color: Palette.text-3;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 11px;
                        background: Palette.accent.with-alpha(0.16);

                        Icon {
                            d: Icons.sliders;
                            tint: Palette.accent;
                            icon-size: 17px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // ---- 分段筛选：全部 / 未读 / 重要 ----
            Rectangle {
                height: 40px;
                border-radius: 14px;
                background: #ffffff0a;
                border-width: 1px;
                border-color: Palette.stroke;

                // 选中态背景，切换时平滑滑动
                Rectangle {
                    property <length> seg-width: (parent.width - 10px) / 3;

                    x: 5px + root.tab * self.seg-width;
                    y: 5px;
                    width: self.seg-width;
                    height: 30px;
                    border-radius: 10px;
                    background: @linear-gradient(135deg, Palette.accent 0%, Palette.accent-2 100%);

                    animate x { duration: 220ms; easing: ease-out; }
                }

                HorizontalLayout {
                    x: 5px;
                    y: 5px;
                    width: parent.width - 10px;
                    height: 30px;
                    spacing: 0px;

                    for label[i] in ["全部", "未读", "重要"]: Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        Text {
                            text: label;
                            font-size: 13px;
                            font-weight: root.tab == i ? 700 : 500;
                            color: root.tab == i ? #ffffff : Palette.text-3;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            animate color { duration: 200ms; }
                        }

                        TouchArea {
                            clicked => { root.tab = i; }
                        }
                    }
                }
            }

            // ---- 置顶公告 ----
            Rectangle {
                border-radius: 22px;
                background: @linear-gradient(135deg, #6e63ff 0%, #3fa9f5 100%);
                drop-shadow-color: Palette.accent.with-alpha(0.35);
                drop-shadow-blur: 26px;
                drop-shadow-offset-y: 10px;

                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    cross-axis-alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;

                        Text {
                            text: "置顶 · 公告";
                            font-size: 11px;
                            font-weight: 600;
                            color: #ffffffb8;
                            letter-spacing: 1px;
                        }

                        Text {
                            text: "Slint 1.18 已发布";
                            font-size: 17px;
                            font-weight: 700;
                            color: #ffffff;
                            overflow: elide;
                        }

                        Text {
                            text: "新的渲染后端，启动更快、动画更顺滑。";
                            font-size: 13px;
                            color: #ffffffd6;
                            wrap: word-wrap;
                            overflow: clip;
                            max-lines: 2;
                        }
                    }

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: #ffffff2e;

                        Icon {
                            d: Icons.chevron;
                            tint: #ffffff;
                            icon-size: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // ---- 通知列表：点一下即标记为已读，分段筛选会实时过滤 ----
            for notice[i] in root.notices: NoticeCard {
                notice: notice;
                visible: root.tab == 0
                    || (root.tab == 1 && notice.unread)
                    || (root.tab == 2 && notice.important);
                open => { root.notices[i].unread = false; }
            }

            Text {
                text: "已经到底啦 · 共 \{root.notices.length} 条通知";
                font-size: 12px;
                color: Palette.text-3;
                horizontal-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }

    // ---- 底部导航 ----
    nav-bar := Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: nav-bar-height;
        background: #0d1322f5;

        // 顶部分割线
        Rectangle {
            width: parent.width;
            height: 1px;
            background: #ffffff14;
        }

        HorizontalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: 64px;

            for item[i] in root.nav-items: NavCell {
                label: item.label;
                icon: item.icon;
                badge: item.badge;
                active: root.nav == i;
                horizontal-stretch: 1;
                select => { root.nav = i; }
            }
        }
    }
}
