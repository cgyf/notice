export struct NoticeChip {
    // 显示文案
    label: string,
    // 色调：0=品牌蓝 1=紫 2=绿 3=橙(警示)。
    // 只传语义化的色调，具体颜色留在前端主题里（见 theme.slint 的 Style.tone-color）。
    tone: int,
}

// 通知类型：0=公告 1=活动 2=安全 3=更新
export struct Notice {
    kind: int,
    title: string,
    body: string,
    // 卡片底部的标签。文案和色调都由后端给，前端不做「kind -> 标签文字」的映射。
    chips: [NoticeChip],
    time: string,
    unread: bool,
    important: bool,
}

// 顶部置顶公告条
export struct PinnedNotice {
    label: string,
    title: string,
    summary: string,
}

export struct NavItem {
    label: string,
    icon: string,
    badge: int,
}